<div id="myModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modaltitle"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="modal-body">
                <iframe width="100%" height="400" frameborder="0" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
            </div>
        </div>
    </div>
</div>

<script src="/public/jquery-3.1.1.min.js"></script>
<script src="/public/popper.min.js"></script>
<script src="/public/bootstrap-4.4.1-dist/js/bootstrap.js"></script>
<script src="/public/bootstrap3-typeahead.min.js"></script>

<script>
    var searchItems = [];
    var searchUrls = {};

    var openModal = function(title, url) {
        if (!url) {
            url = searchUrls[(title || "").toLowerCase()];
        }
        if (!url) {
            return;
        }
        var id = url.match(/[?&]v=([\w-]{6,})/);
        if (!id) {
            return;
        }
        var src = "https://www.youtube.com/embed/" + id[1] + "?autoplay=1&playsinline=1";
        $("#myModal").modal("show");
        $("#modaltitle").text(title);
        $("#myModal iframe").attr("src", src);
    };

    $("#myModal button").click(function () {
        $("#myModal iframe").attr("src", "about:blank");
    });

    $("#myModal").on("hidden.bs.modal", function () {
        $("#myModal iframe").attr("src", "about:blank");
    });

    $.getJSON("/search.json").done(function(data) {
        data.forEach(function(item) {
            if (!item.woord) {
                return;
            }
            searchItems.push(item.woord);
            searchUrls[item.woord.toLowerCase()] = item.url;
        });

        $("#typeahead").typeahead({
            source: function(query, process) {
                var q = query.toLowerCase();
                process(searchItems.filter(function(name) {
                    return name.toLowerCase().indexOf(q) > -1;
                }));
            },
            afterSelect: function(item) {
                openModal(item, searchUrls[item.toLowerCase()]);
            }
        });
    });
</script>

